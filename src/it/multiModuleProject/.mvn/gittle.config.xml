<configuration
  xmlns="http://emergentdotorg.github.io/gitver/configuration/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://emergentdotorg.github.io/gitver/configuration/1.0.0
                      https://emergentdotorg.github.io/gitver-configuration-v1.0.0.xsd">
  <refs>

    <ref>
      <type>tag</type>
      <pattern><![CDATA[v(?<version>.*)]]></pattern>
      <version>${ref.version}</version>
      <updateSourcePom>true</updateSourcePom>
    </ref>

    <ref>
      <type>branch</type>
      <pattern>master</pattern>
      <version>${version.release}-${ref}-${version.label}</version>
      <properties>
        <foo>new_new_new</foo>
      </properties>
    </ref>

    <ref>
      <type>branch</type>
      <pattern>feature/(.+)</pattern>
      <version>${ref}-SNAPSHOT</version>
      <properties>
        <foo>new_new_new</foo>
      </properties>
    </ref>

  </refs>
</configuration>
