<configuration
  xmlns="http://emergentdotorg.github.io/gittle/configuration/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://emergentdotorg.github.io/gittle/configuration/1.0.0
                      https://emergentdotorg.github.io/gittle-configuration-v1.0.0.xsd">

  <refs>

    <ref type="branch">
      <pattern>.+</pattern>
      <version>${describe.tag.version.next}</version>
    </ref>

    <ref type="tag">
      <pattern><![CDATA[v(?<version>.*)]]></pattern>
      <version>${ref.version}</version>
    </ref>

  </refs>

  <rev>
    <version>${commit}</version>
  </rev>

</configuration>
