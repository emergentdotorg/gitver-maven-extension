<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
  xmlns="http://emergentdotorg.github.io/gittle/configuration/1.0.0"
  targetNamespace="http://emergentdotorg.github.io/gittle/configuration/1.0.0">

  <xs:element name="configuration" type="Configuration"/>

  <xs:complexType name="Options">
    <xs:annotation>
      <xs:documentation xml:lang="en">
        Options that can be configured at any level.
      </xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="version" type="xs:string" minOccurs="0"/>
      <xs:element name="tagPattern" type="xs:string" minOccurs="0"/>
      <xs:element name="followFirstParentOnly" type="xs:boolean" minOccurs="0"/>
      <xs:element name="updateAttachedPom" type="xs:boolean" minOccurs="0"/>
      <xs:element name="updateSourcePom" type="xs:boolean" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="Configuration">
    <xs:complexContent mixed="false">
      <xs:extension base="Options">
        <xs:all>

          <xs:element name="disable" type="xs:boolean" minOccurs="0"/>
          <xs:element name="considerTagsOnBranches" type="xs:string" minOccurs="0"/>
          <xs:element name="projectVersionPattern" type="xs:string" minOccurs="0"/>

          <xs:element name="refs" minOccurs="0">
            <xs:annotation>
              <xs:documentation xml:lang="en">
                A sequential set of processing options that are attempted to match against in order.
              </xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:element name="ref" type="RefDetail" minOccurs="0" maxOccurs="unbounded"/>
              </xs:sequence>
            </xs:complexType>
          </xs:element>

          <xs:element name="rev" type="RevDetail" minOccurs="0">
            <xs:annotation>
              <xs:documentation xml:lang="en">
                The fallback processing options when no ref is matched.
              </xs:documentation>
            </xs:annotation>
          </xs:element>

          <xs:element name="relatedProjects" minOccurs="0">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="project" type="Project" minOccurs="0" maxOccurs="unbounded"/>
              </xs:sequence>
            </xs:complexType>
          </xs:element>

        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="RevDetail">
    <xs:annotation>
      <xs:documentation xml:lang="en">
        Git status description with information on how to process a git state.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent mixed="false">
      <xs:extension base="Options">
        <xs:all>
          <xs:element name="properties" minOccurs="0">
            <xs:complexType>
              <xs:sequence>
                <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="userProperties" minOccurs="0">
            <xs:complexType>
              <xs:sequence>
                <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="RefDetail">
    <xs:annotation>
      <xs:documentation xml:lang="en">
        Git status description with information on how to process a git state, as well as
        information on how to determine if this description is a match against the current state.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent mixed="false">
      <xs:extension base="RevDetail">
        <xs:all>
          <xs:element name="pattern" type="xs:string" minOccurs="0">
            <xs:annotation>
              <xs:documentation xml:lang="en">The ref name matching regex.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="type">
            <xs:annotation>
              <xs:documentation xml:lang="en">The ref type to match.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="branch"/>
                <xs:enumeration value="tag"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Project">
    <xs:all>
      <xs:element name="groupId" type="xs:string"/>
      <xs:element name="artifactId" type="xs:string"/>
    </xs:all>
  </xs:complexType>

</xs:schema>
