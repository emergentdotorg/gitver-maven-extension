<configuration
  xmlns="http://emergentdotorg.github.io/gitver/configuration/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://emergentdotorg.github.io/gitver/configuration/1.0.0
                      https://emergentdotorg.github.io/gitver-maven-extension/gitver-configuration-v1.0.0.xsd">

  <!--<disable>false</disable>-->
  <!--<version>${describe.version}</version>-->
  <!--<onlyFollowFirstParent>true</onlyFollowFirstParent>-->
  <!--<considerTagsOnBranches>false</considerTagsOnBranches>-->
  <!--<updateAttached>true</updateAttached>-->
  <!--<updateSource>false</updateSource>-->

  <refs>

    <ref>
      <type>branch</type>
      <pattern>.+</pattern>
      <version>${describe.tag.version.next}</version>
    </ref>

    <ref>
      <type>tag</type>
      <pattern><![CDATA[v(?<version>.*)]]></pattern>
      <version>${ref.version}</version>
    </ref>

  </refs>

  <rev>
    <version>${commit}</version>
  </rev>

</configuration>
