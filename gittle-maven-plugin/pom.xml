  <profiles>
    <profile>
      <id>run-its</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-invoker-plugin</artifactId>
            <dependencies>
              <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-scripting-jsr223</artifactId>
                <version>2.3.21</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>integration-test</id>
                <goals>
                  <goal>install</goal>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <goals>
                    <goal>-ntp</goal>
                    <!--<goal>-Drevision=0.0.1-SNAPSHOT</goal>-->
                    <goal>install</goal>
                  </goals>
                  <pomIncludes>
                    <include>*/pom.xml</include>
                  </pomIncludes>
                  <pomExcludes>
                    <exclude>multiModuleProject/pom.xml</exclude>
                  </pomExcludes>
                  <scope>runtime</scope>
                  <cloneClean>true</cloneClean>
                  <showErrors>true</showErrors>
                  <timeoutInSeconds>60</timeoutInSeconds>
                  <addTestClassPath>true</addTestClassPath>
                  <preBuildHookScript>setup</preBuildHookScript>
                  <postBuildHookScript>verify</postBuildHookScript>
                  <streamLogsOnFailures>true</streamLogsOnFailures>
                  <settingsFile>src/it/settings.xml</settingsFile>
                  <cloneProjectsTo>${project.build.directory}/its</cloneProjectsTo>
                  <localRepositoryPath>${project.build.directory}/local-invoker-repo</localRepositoryPath>
                  <environmentVariables>
                    <HOME>${project.build.directory}/its/tools</HOME>
                    <GIT_CEILING_DIRECTORIES>${project.build.directory}/its</GIT_CEILING_DIRECTORIES>
                  </environmentVariables>
                  <properties>
                    <revision>0.0.1-SNAPSHOT</revision>
                    <user.home>${project.build.directory}/its/tools</user.home>
                    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
                    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
                  </properties>
                  <extraArtifacts>
                    <artifact>junit:junit:3.8.1</artifact>
                  </extraArtifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>flatten</id>
      <build>
        <plugins />
      </build>
    </profile>

    <profile>
      <id>shade</id>
      <build>
        <plugins />
      </build>
    </profile>
  </profiles>
