<configuration xmlns="https://emergentdotorg.github.io/gittle/configuration/1.0.0"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://emergentdotorg.github.io/gittle/configuration/1.0.0
                                   https://emergentdotorg.github.io/gittle-configuration-v1.0.0.xsd">

  <refs considerTagsOnBranches="true">

    <ref type="tag">
      <pattern><![CDATA[v(?<version>.*)]]></pattern>
      <version>${ref.version}</version>
      <updatePom>true</updatePom>
      <!--
      <properties>
        <revision>${ref.version}</revision>
        <rev1>${ref.version}</rev1>
        <rev2>${version}</rev2>
      </properties>
      -->
    </ref>

    <!--
    <ref type="branch">
      <pattern>(main|master)</pattern>
      <version>${version.release}-${ref}-${version.label}-SNAPSHOT</version>
      <properties>
        <foo>new_new_new</foo>
      </properties>
    </ref>
    -->

    <ref type="branch">
      <!--<pattern>feature/(.+)</pattern>-->
      <pattern>.+</pattern>
      <version>${version.release}-${ref}-SNAPSHOT</version>
      <!--<version>${ref}-SNAPSHOT</version>-->
      <!--
      <properties>
        <revision>${version.release}-${ref}-SNAPSHOT</revision>
        <rev1>${version.release}-${ref}-SNAPSHOT</rev1>
        <rev2>${version}</rev2>
      </properties>
      -->
    </ref>

  </refs>

  <rev>
    <version>${version.release}-${version.label}-SNAPSHOT</version>
    <!--<version>${ref}-SNAPSHOT</version>-->
    <!--
    <properties>
      <revision>${version.release}-${version.label}-SNAPSHOT</revision>
      <rev1>${version.release}-${version.label}-SNAPSHOT</rev1>
      <rev2>${version}</rev2>
    </properties>
    -->
  </rev>

</configuration>
